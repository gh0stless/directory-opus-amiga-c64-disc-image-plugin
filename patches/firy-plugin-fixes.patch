From 167d1cf34474c0ec63a6139b4068396f6cc551f3 Mon Sep 17 00:00:00 2001
From: Andreas Schumm <schumm@arcor.de>
Date: Sun, 25 Oct 2026 08:25:31 +0100
Subject: [PATCH 4/4] adf: rewrite file creation and removal

- Out of space threw std::exception from blockUseSingle(); space is now
  checked before anything is written.
- OFS files over 72 blocks got a broken data chain and leaked a block; data,
  header and extension blocks are now allocated up front and written in one
  pass (extension blocks also get their parent pointer).
- Duplicate names leaked a block and left a node that failed every later
  save; names are compared case-insensitively the way AmigaDOS does
  (Latin-1 on international volumes), with a loop guard on hash chains.
- Removal finds the entry by block number instead of by name, frees
  extension blocks, refuses non-empty directories and fixes the root
  directory case.
- Directory and volume modification dates are updated.
- Writing to directory cache (DCFS) volumes is refused, since the cache
  isn't maintained.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 source/images/adf.cpp | 459 ++++++++++++++++++++----------------------
 source/images/adf.hpp |  39 ++--
 2 files changed, 245 insertions(+), 253 deletions(-)

diff --git a/source/images/adf.cpp b/source/images/adf.cpp
index 2ea3b59..f5655d1 100644
--- a/source/images/adf.cpp
+++ b/source/images/adf.cpp
@@ -215,7 +215,7 @@ namespace firy {
 				pHeader->dataSize = 0;
 				pHeader->secType = -3;
 				pHeader->parent = (int32_t)pParent->mBlockNumber;
-				if (mContent->size()) {
+				if (mContent && mContent->size()) {
 					pHeader->byteSize = (uint32_t)mContent->size();
 				}
 				pHeader->access = this->access;
@@ -490,14 +490,26 @@ namespace firy {
 		}
 
 		/**
-		 *
+		 * Write the in-memory changes to the image
 		 */
 		bool cADF::filesystemSaveNative() {
+			// The directory cache of DCFS volumes isn't maintained, so writing would leave
+			// AmigaDOS with stale listings - refuse instead
+			if (isDirCache()) {
+				error("Writing to directory cache (DCFS) volumes is not supported");
+				return false;
+			}
+
 			{
 				std::shared_ptr<adf::sRootBlock> block = blockLoad<adf::sRootBlock>(mBlockRoot);
+				if (!block)
+					return false;
 				block->nameLen = (char)min(adf::gFilenameMaximumLength, mFsName.size());
 				memcpy(block->diskName, mFsName.data(), block->nameLen);
-				blockSaveChecksum(mBlockRoot, block);
