From 6e7b66d984692b0b693bcdddedaf2730fa6af9c2 Mon Sep 17 00:00:00 2001
From: Andreas Schumm <schumm@arcor.de>
Date: Sun, 25 Oct 2026 08:25:30 +0100
Subject: [PATCH 2/4] Make saves and removals report failure instead of losing
 data

filesystemSave() now returns the result of writing the source back, so a
failed write is no longer reported as success. sNode::remove() only detaches
a node once the filesystem actually dropped it, and sDirectory::add() takes
the node out of the tree again if saving it failed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 source/filesystem/filesystem.cpp | 24 ++++++++++++++++++++----
 source/images/image.cpp          |  2 +-
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/source/filesystem/filesystem.cpp b/source/filesystem/filesystem.cpp
index b06e0ab..92a0ffa 100644
--- a/source/filesystem/filesystem.cpp
+++ b/source/filesystem/filesystem.cpp
@@ -61,11 +61,18 @@ namespace firy {
 		 * Remove
 		 */
 		bool sNode::remove() {
+			auto fs = mFilesystem.lock();
+			if (!fs)
+				return false;
+
+			// Only detach from the parent once the filesystem actually dropped the entry
+			if (!fs->filesystemRemove(shared_from_this()))
+				return false;
+
 			if (!mParent.expired())
 				mParent.lock()->nodeRemove(shared_from_this());
 
-			mFilesystem.lock()->filesystemRemove(shared_from_this());
-			return mFilesystem.lock()->filesystemSave();
+			return fs->filesystemSave();
 		}
 
 		/**
@@ -118,10 +125,19 @@ namespace firy {
 		 * Add to the file system
 		 */
 		bool sDirectory::add(spNode pNode) {
+			auto fs = mFilesystem.lock();
+			if (!fs)
+				return false;
+
 			nodeAdd(pNode);
-			mFilesystem.lock()->dirty();
+			fs->dirty();
 			dirty();
-			return mFilesystem.lock()->filesystemSave();
+			if (fs->filesystemSave())
+				return true;
+
+			// Don't leave a node in the tree that never made it onto the disk
+			nodeRemove(pNode);
+			return false;
 		}
 
 		/**
diff --git a/source/images/image.cpp b/source/images/image.cpp
index 8198d14..5de98ae 100644
--- a/source/images/image.cpp
+++ b/source/images/image.cpp
@@ -55,7 +55,7 @@ namespace firy {
 				return false;
 
 			if (sourceIsDirty() && !savechanges("Save Changes")->isAborted()) {
-				sourceSave();
+				return sourceSave();
 			}
 			return true;
 		}
-- 
