From 02a6d6c15acd53a23d5ad5e7261150e3792c729f Mon Sep 17 00:00:00 2001
From: Andreas Schumm <schumm@arcor.de>
Date: Sun, 25 Oct 2026 08:25:31 +0100
Subject: [PATCH 3/4] d64: fix scratching, directory growth, D71 BAM and space
 handling

- Removing a file recursed into itself until the stack overflowed. Files are
  now scratched like CBM DOS does it: type byte 0, blocks back to the BAM.
  REL and GEOS files are refused (their extra sectors aren't in the chain).
- Directory entry offsets were stored as i*20 instead of i*0x20, so saving
  an entry wrote over its neighbour.
- Scratched entries were listed as files and their slots never reused.
- Growing the directory picked sector+3 without checking or allocating it
  and without clearing it; it now allocates a free sector on the directory
  track with the drive's interleave and initialises it.
- D71 second-side BAM was read and written in the D64 layout; it now uses
  the 18/0 free counts and the 3-byte bitmaps in 53/0.
- Files are never placed on the directory track (or D71 track 53), and a
  disk without enough space fails up front instead of reporting success.
- Empty files get the single 00 01 block CBM DOS writes for them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 source/images/d64.cpp | 255 ++++++++++++++++++++++++++++++------------
 source/images/d64.hpp |   5 +
 2 files changed, 190 insertions(+), 70 deletions(-)

diff --git a/source/images/d64.cpp b/source/images/d64.cpp
index bc5aabb..534aea1 100644
--- a/source/images/d64.cpp
+++ b/source/images/d64.cpp
@@ -242,6 +242,44 @@ namespace firy {
 			return sectorWrite(pTS, block);
 		}
 
+		/**
+		 * D71 second side (tracks 36-70): the free counts sit in 18/0 at 0xDD, one byte
+		 * per track, and the bitmaps in 53/0 from offset 0, three bytes per track
+		 */
+		bool cD64::loadBamD71Side2() {
+			auto counts = sectorRead({ 18, 0 });
+			auto bitmaps = sectorRead({ 53, 0 });
+			if (!counts || !bitmaps)
+				return false;
+
+			for (tTrack track = 36; track <= 70; ++track) {
+				const size_t index = track - 36;
+				d64::sTrackBam bam;
+				bam.mFreeSectors = counts->getByte(0xDD + index);
+				bam.mSectors = 0;
+				for (size_t b = 0; b < 3; ++b)
+					bam.mSectors |= (uint64_t)bitmaps->getByte(index * 3 + b) << (8 * b);
+				mBam.push_back(bam);
+			}
+			return true;
+		}
+
+		bool cD64::saveBamD71Side2() {
+			auto counts = sectorRead({ 18, 0 });
+			auto bitmaps = sectorRead({ 53, 0 });
+			if (!counts || !bitmaps)
+				return false;
+
+			for (tTrack track = 36; track <= 70; ++track) {
+				const size_t index = track - 36;
+				const auto& bam = mBam.at(track - 1);
+				counts->putByte(0xDD + index, bam.mFreeSectors);
+				for (size_t b = 0; b < 3; ++b)
+					bitmaps->putByte(index * 3 + b, (uint8_t)(bam.mSectors >> (8 * b)));
+			}
+			return sectorWrite({ 18, 0 }, counts) && sectorWrite({ 53, 0 }, bitmaps);
+		}
